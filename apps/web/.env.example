# Vercel Environment Configuration
# Copy this file to .env.local and set the values for your deployment.
# For local development, copy to .env and adjust API_INTERNAL_URL.
# These values go to VERCEL as Environment Variables (server-side only).

# Next.js Application
# The URL where your Vercel deployment is served (e.g., https://advocatepro.vercel.app)
NEXT_PUBLIC_APP_URL=https://advocatepro.vercel.app

# API INTERNAL URL - the hosted FastAPI backend
# Used by the Next.js API routes to proxy to the backend.
# In Vercel, set this to your backend URL (e.g., https://your-api.railway.app)
# For local dev, use http://localhost:8000
API_INTERNAL_URL=https://your-api-domain.example.com/api

# JWT Secret for production - MUST be at least 32 random characters
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=replace-with-a-unique-32+ character-secret-for-production

# Database connection string (connection string to your hosted PostgreSQL)
# Format:postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://username:password@your-db-host.com:5432/lms_db

# Redis connection string (for the Celery worker)
# Format: redis://default:password@your-redis-host.com:6379/0
REDIS_URL=redis://default:password@your-redis-host.com:6379/0

# CORS Origins - allow only your Vercel domain(s)
API_CORS_ORIGINS=https://your-domain.example.com

# Application Environment
APP_ENVIRONMENT=production

# Bootstrap Admin (only used for local setup, not in production)
BOOTSTRAP_ADMIN_NAME=Demo Administrator
BOOTSTRAP_ADMIN_PHONE=+919900000001
BOOTSTRAP_ADMIN_EMAIL=admin@demo.advocatepro.test
BOOTSTRAP_ADMIN_PASSWORD=AdminDemo@2026!
RESET_BOOTSTRAP_ADMIN_PASSWORD=false

# Demo Admin (only for local setup)
DEMO_ADMIN_PHONE=+919900000001
DEMO_ADMIN_PASSWORD=AdminDemo@2026!
DEMO_API_BASE_URL=https://your-api-domain.example.com/api
