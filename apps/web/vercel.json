{
  "name": "advocatepro-web",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "outputDirectory": ".next/standalone"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "@next-public-app-url",
    "API_INTERNAL_URL": "@api-internal-url",
    "JWT_SECRET_KEY": "@jwt-secret-key",
    "DATABASE_URL": "@database-url",
    "REDIS_URL": "@redis-url",
    "API_CORS_ORIGINS": "@api-cors-origins",
    "APP_ENVIRONMENT": "production",
    "BOOTSTRAP_ADMIN_NAME": "@bootstrap-admin-name",
    "BOOTSTRAP_ADMIN_PHONE": "@bootstrap-admin-phone",
    "BOOTSTRAP_ADMIN_EMAIL": "@bootstrap-admin-email",
    "BOOTSTRAP_ADMIN_PASSWORD": "@bootstrap-admin-password",
    "RESET_BOOTSTRAP_ADMIN_PASSWORD": "@reset-bootstrap-admin-password",
    "DEMO_ADMIN_PHONE": "@demo-admin-phone",
    "DEMO_ADMIN_PASSWORD": "@demo-admin-password",
    "DEMO_API_BASE_URL": "@demo-api-base-url"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_APP_URL": "@next-public-app-url",
      "API_INTERNAL_URL": "@api-internal-url",
      "JWT_SECRET_KEY": "@jwt-secret-key",
      "DATABASE_URL": "@database-url",
      "REDIS_URL": "@redis-url",
      "API_CORS_ORIGINS": "@api-cors-origins",
      "APP_ENVIRONMENT": "production",
      "BOOTSTRAP_ADMIN_NAME": "@bootstrap-admin-name",
      "BOOTSTRAP_ADMIN_PHONE": "@bootstrap-admin-phone",
      "BOOTSTRAP_ADMIN_EMAIL": "@bootstrap-admin-email",
      "BOOTSTRAP_ADMIN_PASSWORD": "@bootstrap-admin-password",
      "RESET_BOOTSTRAP_ADMIN_PASSWORD": "@reset-bootstrap-admin-password",
      "DEMO_ADMIN_PHONE": "@demo-admin-phone",
      "DEMO_ADMIN_PASSWORD": "@demo-admin-password",
      "DEMO_API_BASE_URL": "@demo-api-base-url"
    }
  }
}